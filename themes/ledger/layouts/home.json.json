{{- /* 首页的 JSON 输出：把 site/data/entries.json 归一化成前端检索索引（/entries.json）。

       归一化逻辑在 layouts/_partials/json/条目索引.html 里，**只有一份**：
       分节的 /NN-节名/entries.json 调的是同一个 partial，所以两边字段一致、
       不会各写一套然后悄悄漂移。条目页徽章用 layouts/_partials/logic/ 下同一批档位函数。
       原始条目仍是 book/ 下的正文，这份 JSON 是派生产物，不反向维护。

       本文件只负责「整站」这一层：套上 generated / count / staleDays 外壳。

       ⚠ 这是给**前端检索**用的，体量 846 KB，不要整份读进模型上下文。
       AI 云端取数请用节点端点 /NN-节名/entries.json（每节 24–84 KB）。 */ -}}
{{- $list := partial "json/条目索引.html" (hugo.Data.entries | default slice) -}}
{{- dict
  "generated" (now.Format "2006-01-02T15:04:05Z07:00")
  "count" (len $list)
  "staleDays" (site.Params.staleDays | default 180)
  "entries" $list
  | jsonify -}}
